# .env.example — AUTOMATA Backend Environment Variables
#
# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit .env or any file containing real secrets.
# See SKILLS.md §8 for the full credentials & secrets handling checklist.
#
# Placeholder convention: values starting with "REPLACE_" must be replaced
# before the feature that depends on them will function.

# ─── CockroachDB ──────────────────────────────────────────────────────────────
# Full PostgreSQL-compatible connection string.
# Format: postgresql+psycopg2://user:password@host:port/database?sslmode=verify-full
# Obtain from CockroachDB Cloud → your cluster → Connect.
COCKROACHDB_CONNECTION_STRING=REPLACE_WITH_COCKROACHDB_CONNECTION_STRING

# ─── Ollama (free, local LLM backend) ────────────────────────────────────────
# Ollama is the default free backend — no API keys required.
# Install from https://ollama.com and pull models:
#   ollama pull qwen2.5:7b      (for chat)
#   ollama pull nomic-embed-text (for embeddings)
#
# Ollama runs as a local service at http://localhost:11434 by default.
# Change OLLAMA_BASE_URL if Ollama runs on a different host/port.
# Change OLLAMA_MODEL to the model you have pulled locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── AWS / Amazon Bedrock (optional — uncomment when keys are available) ──
# AWS_REGION=REPLACE_WITH_AWS_REGION
# # Bedrock model ID for reasoning (e.g. anthropic.claude-3-5-sonnet-20241022-v2:0)
# # Fill in once model is decided — see TECH_STACK.md "AI" section.
# AWS_BEDROCK_MODEL_ID=REPLACE_WITH_MODEL_ID
# # Standard AWS credentials — use IAM role or environment credentials when possible.
# # If using IAM role (EC2/Lambda), leave these blank and remove them.
# AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY

# ─── Optional API Keys (fallback LLM backends) ───────────────────────────────
# These are fallback options when Bedrock is not configured.
# Priority order: Bedrock → NVIDIA → Groq → Gemini → Minimax → Ollama (free local fallback)
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_EMBEDDING_API_KEY=REPLACE_WITH_GROQ_EMBEDDING_API_KEY
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
MINIMAX_API_KEY=REPLACE_WITH_MINIMAX_API_KEY

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Bedrock embedding model ID (e.g. amazon.titan-embed-text-v2:0)
# Dimension must match CockroachDB vector column definition in schema.sql.
# When using Ollama, these are optional — Ollama handles embeddings locally.
# EMBEDDING_MODEL_ID=REPLACE_WITH_EMBEDDING_MODEL_ID
# EMBEDDING_DIMENSION=REPLACE_WITH_DIMENSION_INTEGER

# ─── Embedding API Keys (optional) ──────────────────────────────────────────
# Separate keys for embedding generation (can differ from chat keys).
# Priority: Groq embedding → Gemini embedding → Ollama embedding

# ─── Logging ──────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
