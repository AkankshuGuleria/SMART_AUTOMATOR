# backend/.env.example — AUTOMATA agent configuration
#
# Copy to backend/.env (git-ignored) and fill in only what you use.
# EVERYTHING here is optional: with no keys at all AUTOMATA runs on local memory
# and, if installed, a local Ollama model. Never commit a real value.
# Empty values (or values starting with REPLACE_) count as "not set".

# ─── Cloud memory copy (optional) ─────────────────────────────────────────────
# CockroachDB keeps a cloud copy of memory; the local SQLite memory works without it.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full
COCKROACHDB_CONNECTION_STRING=

# ─── Model routing ────────────────────────────────────────────────────────────
# auto  = configured cloud providers first, then Bedrock, then local Ollama
# local = Ollama only (offline, no API costs)
# cloud = cloud providers and Bedrock only
REASONING_MODE=auto

# ─── Local models — Ollama (https://ollama.com) ───────────────────────────────
# Setup & health → Local AI recommends a model for your GPU and downloads it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Folder for downloaded models (useful when C: is short on space), e.g. D:\ollama-models
# OLLAMA_MODELS=

# ─── Cloud reasoning providers (any subset) ───────────────────────────────────
# Tried in this order when set: Groq → OpenRouter → Gemini → Cohere → NVIDIA → MiniMax → Bedrock.
GROQ_API_KEY=
GROQ_EMBEDDING_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
GEMINI_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
MINIMAX_API_KEY=

# ─── Amazon Bedrock (optional) ────────────────────────────────────────────────
# Prefer an AWS profile / SSO over long-lived keys where possible.
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Cloud embeddings (optional) ──────────────────────────────────────────────
# Only needed for a cloud embedding model; the dimension must match the
# VECTOR columns in backend/db/schema.sql (default 1024).
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
