# .gitignore — AUTOMATA
# Note: git does not support comments at the end of a pattern line.

# ─── Secrets (never commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
credentials.json
serviceAccount*.json

# ─── Python / backend ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.Python
.uv_cache/
.tools/
/uv.exe
/uvx.exe
/uvw.exe
backend/tmp/

# ─── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local

# ─── Tauri / Rust ─────────────────────────────────────────────────────────────
# Cargo.lock is committed (reproducible desktop builds); build output is not.
frontend/src-tauri/target/

# ─── Generic build output ─────────────────────────────────────────────────────
dist/
build/

# ─── Tests, linters, coverage ─────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS and editors ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ─── AI coding assistants ─────────────────────────────────────────────────────
# Shared project rules are committed; local caches, worktrees and plans are not.
.cursor/
.claude/*
!.claude/rules/
.kilo/*
!.kilo/rules/

# ─── Demo recordings (large) ──────────────────────────────────────────────────
demo/*.mp4
demo/*.mov
demo/*.webm
